# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GITHUB_TOKEN: Optional Fine-Grained Personal Access Token (Contents: Read & Write on znep/znep-link-cleaner)
# Configure GITHUB_TOKEN in the AI Studio Secrets panel so the container daemon (server.py / sync_github.py)
# automatically pushes every new release as a separate prompt-annotated commit to https://github.com/znep/znep-link-cleaner.
# (Ignored by Secrets Gradle Plugin via ignoreList so it is NEVER packaged into the Android APK).
# GITHUB_TOKEN=ghp_your_github_pat_here
